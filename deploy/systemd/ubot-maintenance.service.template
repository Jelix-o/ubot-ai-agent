[Unit]
Description=UBot V3 retention maintenance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubot
Group=ubot
WorkingDirectory=/opt/ai-project-releases/current
EnvironmentFile=/opt/ai-project/.env
Environment=UBOT_APP_ROOT=/opt/ai-project
Environment=UBOT_MANAGED_PREVIEW_ROOT=/var/lib/ubot-preview
Environment=UBOT_RELEASE_ROOT=/opt/ai-project-releases
Environment=NODE_ENV=production
Environment=PATH=/opt/ubot-runtime/node22/bin:/usr/bin:/bin
ExecStart=/opt/ubot-runtime/node22/bin/node scripts/migrate-v3-state.mjs --maintenance --execute
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
ReadWritePaths=/opt/ai-project/data /var/lib/ubot-preview
