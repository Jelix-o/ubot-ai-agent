[Unit]
Description=UBot V3 worker (conversation, schedules and model orchestration)
After=network-online.target ubot-ingress.service
Wants=network-online.target
PartOf=ubot.target

[Service]
Type=simple
User=ubot
Group=ubot
WorkingDirectory=/opt/ai-project-releases/current
EnvironmentFile=/opt/ai-project/.env
Environment=BOT_ROLE=worker
Environment=NODE_ENV=production
Environment=PATH=/opt/ubot-runtime/node22/bin:/usr/bin:/bin
ExecStart=/opt/ubot-runtime/node22/bin/node dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
ReadWritePaths=/opt/ai-project/data /var/lib/ubot-preview

[Install]
WantedBy=ubot.target
