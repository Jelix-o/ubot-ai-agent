# =========================================
# UBot 环境变量模板
# 复制本文件为 .env 后再填写
# =========================================

# NapCat 接入模式
# 可选值：forward / reverse
# forward：机器人主动连接 NapCat
# reverse：NapCat 主动连接机器人
NAPCAT_MODE=reverse

# NapCat 正向 WebSocket 地址
# 仅在 NAPCAT_MODE=forward 时生效
NAPCAT_WS_URL=

# NapCat 的访问 token
# 正向和反向模式都建议填写
# Reverse WS auth uses Authorization: Bearer <token>. URL query tokens are rejected.
# Required when NAPCAT_REVERSE_WS_HOST is not localhost / 127.0.0.1 / ::1.
NAPCAT_ACCESS_TOKEN=

# 机器人反向 WebSocket 监听地址
# 如果和 NapCat 在同一台机器，通常填 127.0.0.1
# 如果要让其他机器上的 NapCat 来连，可改成 0.0.0.0
# Public bind addresses such as 0.0.0.0 require NAPCAT_ACCESS_TOKEN.
NAPCAT_REVERSE_WS_HOST=127.0.0.1

# 机器人反向 WebSocket 监听端口
NAPCAT_REVERSE_WS_PORT=6199

# 机器人反向 WebSocket 路径
NAPCAT_REVERSE_WS_PATH=/onebot/ws

# Ingress 只读 API 端口（worker/admin 通过它访问 NapCat 只读动作）
INGRESS_READ_API_PORT=6198

# 文本模型接口地址
# 例如 OpenAI 兼容网关、MiMo 兼容地址等
OPENAI_BASE_URL=

# 文本模型 API Key
OPENAI_API_KEY=

# 文本模型名称
# 例如：gpt-4.1-mini / mimo-v2-pro / mimo-v2-omni
OPENAI_MODEL=

# Self-hosted SearXNG endpoint for general real-time web lookup.
# It must bind only to loopback; the default is http://127.0.0.1:8088.
REALTIME_SEARCH_URL=http://127.0.0.1:8088

# TTS 接口地址
# MiMo V2.5 TTS 默认使用官方 API 域名
TTS_BASE_URL=https://api.xiaomimimo.com/v1

# TTS API Key
# 如果留空，项目会回退复用 OPENAI_API_KEY
TTS_API_KEY=

# TTS 模型名
# 例如：mimo-v2.5-tts
TTS_MODEL=mimo-v2.5-tts

# TTS 音色
# 例如：mimo_default / default_zh / default_en
TTS_VOICE=

# TTS 输出音频格式
# 通常保留 wav 即可
TTS_AUDIO_FORMAT=wav

# 全局附加 TTS 风格提示
# 可留空
TTS_STYLE_HINT=

# TTS 失败时是否允许回退到 NapCat AI 语音
# true / false
TTS_ALLOW_NAPCAT_AI_FALLBACK=false

# 机器人自己的 QQ 号
BOT_QQ=

# 进程角色（服务化拆分）
# ingress / worker / admin / legacy
# Linux systemd 每个 unit 设置一个角色；Windows run.cmd 会拉起前三者。
BOT_ROLE=

# 公网后台，默认关闭
# 生产建议通过 Nginx 将 https://bot.9958.uk 反代到 127.0.0.1:6200
ADMIN_HTTP_ENABLED=false
ADMIN_HTTP_HOST=127.0.0.1
ADMIN_HTTP_PORT=6200
ADMIN_PUBLIC_BASE_URL=https://bot.9958.uk
# 仅用于账户表为空时的首次超级管理员导入；绑定 TOTP 后不再是登录来源。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# V3 SQLite 状态、加密回滚归档和管理员 TOTP 的 32-byte 主密钥（64 位 hex 或 base64url）。
# 生产环境必须从批准的密钥管理器注入，绝不可提交或放入 Release 包。
UBOT_STATE_ENCRYPTION_KEY=
# 已退休：ADMIN_SESSION_SECRET、ADMIN_TOTP_ENCRYPTION_KEY。V3 不读取它们。
